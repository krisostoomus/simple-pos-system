@page "/"
@implements IDisposable
@inject PosApiClient Api
@inject CartService Cart
@inject StockHubClient Hub
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<UiStrings> L

<header class="pos-page-head">
    <h1 class="pos-title">@L["AppTitle"]</h1>
</header>

@if (_products is null)
{
    <div class="pos-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudGrid>
        @{ var _i = 0; }
        @foreach (var p in _products)
        {
            <MudItem xs="6" sm="4" md="3">
                <ProductCard Product="p" Quantity="Cart.QuantityOf(p.Id)" Index="_i++" OnAddToCart="Add" />
            </MudItem>
        }
    </MudGrid>

    <BasketPanel Lines="BasketLines" OnAdd="Add" OnRemove="RemoveItem" OnRemoveLine="RemoveLine" />

    <div class="pos-checkout-bar">
        <div class="pos-total">
            <span class="pos-total-label">@L["Total"]</span>
            <span class="pos-total-amount">@Money.FormatEuro(TotalCents)</span>
        </div>
        @if (HasStockIssues)
        {
            <span class="pos-checkout-warn">⚠ @L["BasketStockWarning"]</span>
        }
        <MudSpacer />
        <MudButton OnClick="Reset" Disabled="Cart.IsEmpty" StartIcon="@Icons.Material.Filled.Clear" Class="mr-2">@L["Reset"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" OnClick="OpenCheckout" Disabled="Cart.IsEmpty || HasStockIssues"
                   StartIcon="@Icons.Material.Filled.ShoppingCartCheckout">@L["Checkout"]</MudButton>
    </div>
}

@code {
    private IReadOnlyList<ProductModel>? _products;
    private Dictionary<int, int> _priceById = new();

    private int TotalCents => Cart.TotalCents(_priceById);

    // Lines for the basket panel, in product-grid order. Joins the cart's quantities with the loaded
    // products so each line carries name, unit price and current stock (for the +/− stock cap).
    private IReadOnlyList<BasketLine> BasketLines =>
        _products is null
            ? []
            : _products
                .Where(p => Cart.QuantityOf(p.Id) > 0)
                .Select(p => new BasketLine(p, Cart.QuantityOf(p.Id)))
                .ToList();

    // Some basket line now exceeds available stock — checkout would be rejected by the server.
    private bool HasStockIssues => BasketLines.Any(l => l.ExceedsStock);

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        Hub.StockChanged += OnStockChanged;
        await Hub.StartAsync();
        await Load();
    }

    private async Task Load()
    {
        _products = await Api.GetProductsAsync();
        _priceById = _products.ToDictionary(p => p.Id, p => p.PriceCents);
    }

    private void Add(int productId) => Cart.Add(productId);
    private void RemoveItem(int productId) => Cart.Remove(productId);
    private void RemoveLine(int productId) => Cart.RemoveLine(productId);
    private void Reset() => Cart.Reset();

    private void OnStockChanged(int productId, int newQuantity)
    {
        if (_products is null) return;

        // Warn if this product is in the basket and just dropped below the quantity the seller holds.
        var inCart = Cart.QuantityOf(productId);
        if (inCart > 0 && newQuantity < inCart)
        {
            var name = _products.FirstOrDefault(p => p.Id == productId)?.Name ?? "";
            var message = newQuantity <= 0
                ? string.Format(L["NowSoldOut"], name)
                : string.Format(L["StockReduced"], name, newQuantity);
            Snackbar.Add(message, Severity.Warning);
        }

        _products = _products
            .Select(p => p.Id == productId ? p with { StockQuantity = newQuantity } : p)
            .ToList();
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenCheckout()
    {
        var body = new CheckoutBody(Cart.ToLines(), CashPaidCents: 0);
        var parameters = new DialogParameters { ["TotalCents"] = TotalCents, ["Body"] = body };
        var dialog = await Dialogs.ShowAsync<CheckoutDialog>(L["Checkout"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            if (result.Data is CheckoutResultModel completed)
                Snackbar.Add(string.Format(L["SaleComplete"], Money.FormatEuro(completed.ChangeCents)), Severity.Success);

            // Cart was already cleared inside the dialog on successful payment; just refresh stock.
            await Load(); // refresh stock after a completed sale
        }
    }

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
        Hub.StockChanged -= OnStockChanged;
    }
}

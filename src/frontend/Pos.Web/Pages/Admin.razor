@page "/admin"
@implements IDisposable
@inject PosApiClient Api
@inject AuthState Auth
@inject IDialogService Dialogs
@inject IStringLocalizer<UiStrings> L

<PageTitle>@L["Admin"] · @L["AppTitle"]</PageTitle>

<div class="pos-admin-head">
    <h1 class="pos-title">@L["Admin"]</h1>
</div>

@if (!Auth.IsStaff)
{
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ShowLogin">@L["StaffLogin"]</MudButton>
}
else if (_products is not null)
{
    <MudTabs Elevation="0" Rounded="true" Color="Color.Transparent" Class="mt-2">
        
        <MudTabPanel Text="@L["SecondHandStock"]" Icon="@Icons.Material.Filled.Inventory2">
            <MudTable Items="SecondHandProducts" Hover="true">
                <HeaderContent>
                    <MudTh>@L["SecondHand"]</MudTh><MudTh>@L["Quantity"]</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>
                        <MudNumericField T="int" Value="@_edits[context.Id]" Min="0"
                                         ValueChanged="@(v => _edits[context.Id] = v)" />
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => Save(context.Id))">@L["Save"]</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@L["SalesSummary"]" Icon="@Icons.Material.Filled.Insights">
            <section class="pos-report">
                <div class="pos-metrics">
                    <div class="pos-metric">
                        <span class="pos-metric-label">@L["FundsRaised"]</span>
                        <span class="pos-metric-value pos-metric-value--accent">@Money.FormatEuro(_report?.TotalFundsCents ?? 0)</span>
                    </div>
                    <div class="pos-metric">
                        <span class="pos-metric-label">@L["Orders"]</span>
                        <span class="pos-metric-value">@(_report?.OrderCount ?? 0)</span>
                    </div>
                </div>

                @if (_report is { Items.Count: > 0 })
                {
                    <table class="pos-report-table">
                        <thead>
                            <tr>
                                <th>@L["Product"]</th>
                                <th class="pos-num">@L["Sold"]</th>
                                <th class="pos-num">@L["Revenue"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _report.Items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td class="pos-num">@item.QuantitySold</td>
                                    <td class="pos-num">@Money.FormatEuro(item.RevenueCents)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="pos-report-empty">@L["NoSales"]</p>
                }
            </section>
        </MudTabPanel>

        
    </MudTabs>
}

@code {
    private IReadOnlyList<ProductModel>? _products;
    private ReportSummaryModel? _report;
    private readonly Dictionary<int, int> _edits = new();
    private IEnumerable<ProductModel> SecondHandProducts =>
        _products?.Where(p => p.Category == ProductCategories.SecondHand) ?? Enumerable.Empty<ProductModel>();

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        if (Auth.IsStaff) await Load();
    }

    private void OnAuthChanged()
        => _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose() => Auth.Changed -= OnAuthChanged;

    private async Task Load()
    {
        if (!Auth.IsStaff) { _products = null; _report = null; return; }
        _products = await Api.GetProductsAsync();
        foreach (var p in _products) _edits[p.Id] = p.StockQuantity;
        // Reporting is a read-only extra; never let it block stock management.
        try { _report = await Api.GetReportSummaryAsync(); } catch { _report = null; }
    }

    private async Task ShowLogin()
    {
        var dialog = await Dialogs.ShowAsync<StaffLoginDialog>(L["StaffLogin"]);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task Save(int productId)
    {
        await Api.SetStockAsync(productId, _edits[productId]);
        await Load();
    }
}

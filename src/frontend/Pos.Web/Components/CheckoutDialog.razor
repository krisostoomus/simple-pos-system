@using System.Globalization
@inject IStringLocalizer<UiStrings> L

<MudDialog>
    <DialogContent>
        @if (_result is null)
        {
            <div class="pos-pay">
                <div class="pos-pay-summary">
                    <span class="pos-pay-label">@L["Total"]</span>
                    <span class="pos-pay-total">@Money.FormatEuro(TotalCents)</span>
                </div>

                <div class="pos-pay-tender">
                    <button type="button" class="pos-tender pos-tender--exact" disabled="@_busy"
                            @onclick="@(() => Tender(TotalCents))">@L["Exact"]</button>
                    @foreach (var note in QuickNotes)
                    {
                        <button type="button" class="pos-tender"
                                disabled="@(_busy || note < TotalCents)"
                                @onclick="@(() => Tender(note))">@Money.FormatEuro(note)</button>
                    }
                </div>

                <MudTextField @ref="_cashField" @bind-Value="_cashText" Label="@L["CashReceived"]"
                              Variant="Variant.Outlined" Class="pos-pay-field"
                              InputMode="@(InputMode.@decimal)" Immediate="true" OnKeyDown="OnCashKeyDown" />

                @if (ChangePreviewCents is int preview)
                {
                    <div class="pos-pay-change">
                        <span class="pos-pay-change-label">@L["Change"]</span>
                        <span class="pos-pay-change-amount">@Money.FormatEuro(preview)</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="pos-pay">
                <div class="pos-change-hero">
                    <span class="pos-change-hero-label">@L["Change"]</span>
                    <span class="pos-change-hero-amount">@Money.FormatEuro(_result.ChangeCents)</span>
                </div>

                @if (_result.Change.Count > 0)
                {
                    <div class="pos-change-pieces">
                        @foreach (var piece in _result.Change)
                        {
                            <div class="pos-change-piece">
                                <span class="pos-change-piece-count">@piece.Count×</span>
                                <span class="pos-change-piece-denom">@Money.FormatEuro(piece.DenominationCents)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        @if (_result is null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Pay" Disabled="@(_busy || ParsedCents is null)">@L["Pay"]</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Done">OK</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int TotalCents { get; set; }
    [Parameter] public CheckoutBody Body { get; set; } = default!;
    [Inject] private PosApiClient Api { get; set; } = default!;
    [Inject] private CartService Cart { get; set; } = default!;

    // Common notes a customer hands over, in cents (€5 · €10 · €20 · €50).
    private static readonly int[] QuickNotes = [500, 1000, 2000, 5000];

    private MudTextField<string> _cashField = default!;
    private string? _cashText;
    private bool _busy;
    private string? _error;
    private CheckoutResultModel? _result;

    // One key per dialog instance = one checkout intent. Reused on the conflict-retry below and on any
    // manual re-tap after an ambiguous failure, so the server replays the original order instead of
    // creating a duplicate. A genuinely new sale opens a new dialog and gets a fresh key.
    private readonly Guid _idempotencyKey = Guid.NewGuid();

    // The typed amount, parsed to cents (null while the field is empty or unparseable).
    private int? ParsedCents => ParseCents(_cashText);

    // Advisory change shown before paying; the server stays authoritative on checkout.
    private int? ChangePreviewCents
        => ParsedCents is int cents && cents >= TotalCents ? cents - TotalCents : null;

    // Put the cursor straight in the cash field so the seller can just type the amount.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _cashField.FocusAsync();
    }

    // Tap a note (or "Exact") to fill the amount; the cashier still confirms with Pay.
    private void Tender(int cents)
        => _cashText = (cents / 100m).ToString("0.00", CultureInfo.InvariantCulture);

    // Enter pays (while the payment is still pending), matching the cashier's keypad muscle memory.
    private async Task OnCashKeyDown(KeyboardEventArgs e)
    {
        if ((e.Key is "Enter" or "NumpadEnter") && !_busy && _result is null && ParsedCents is not null)
            await Pay();
    }

    private async Task Pay()
    {
        if (ParsedCents is not int cents) return;
        _busy = true; _error = null;
        var body = Body with { CashPaidCents = cents };
        try
        {
            for (var attempt = 1; ; attempt++)
            {
                try
                {
                    _result = await Api.CheckoutAsync(body, _idempotencyKey);
                    // Empty the cart the moment payment succeeds — before the sale's own StockChanged
                    // broadcast arrives, so it can't misfire out-of-stock warnings on items we just sold.
                    Cart.Reset();
                    return;
                }
                catch (ApiException ex) when (ex.ErrorCode == "concurrency_conflict" && attempt < 2)
                {
                    // Transient conflict (two sellers raced) — retry once before surfacing an error.
                }
                catch (ApiException ex)
                {
                    _error = MapError(ex.ErrorCode);
                    return;
                }
                catch
                {
                    _error = L["ErrorGeneric"];
                    return;
                }
            }
        }
        finally { _busy = false; }
    }

    // Accepts "5", "5.50" or "5,50" — both decimal separators, regardless of UI culture.
    private static int? ParseCents(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var normalized = text.Trim().Replace(" ", "").Replace(',', '.');
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out var euro) && euro >= 0
            ? (int)Math.Round(euro * 100)
            : null;
    }

    private string MapError(string errorCode) => errorCode switch
    {
        "out_of_stock" => L["ErrorOutOfStock"],
        "insufficient_payment" => L["ErrorInsufficientPayment"],
        _ => L["ErrorGeneric"],
    };

    private void Cancel() => Dialog.Cancel();
    private void Done() => Dialog.Close(DialogResult.Ok(_result));
}

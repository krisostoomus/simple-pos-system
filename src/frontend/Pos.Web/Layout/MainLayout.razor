@inherits LayoutComponentBase
@implements IDisposable
@using Pos.Web.Components
@using Pos.Web.Resources
@using Pos.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiStrings> L
@inject AuthState Auth

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary" Class="pos-appbar">
        <a href="/" class="pos-brand" aria-label="@L["AppTitle"]">
            <span class="pos-brand-mark">✻</span>
            <span class="pos-brand-text">@L["AppTitle"]</span>
        </a>
        <MudSpacer />
        <LanguageSwitcher />
        <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Inventory">@L["Admin"]</MudButton>
        @if (Auth.IsStaff)
        {
            <MudButton OnClick="Logout" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">@L["Logout"]</MudButton>
        }
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#10B981",        // the one accent — vibrant mint
            Secondary = "#059669",      // emerald, pressed
            Tertiary = "#64748B",       // muted slate
            AppbarBackground = "#FFFFFF",
            Background = "#F9FAFB",      // crisp off-white canvas
            Surface = "#FFFFFF",
            TextPrimary = "#1E293B",    // deep slate
            TextSecondary = "#64748B",
            ActionDefault = "#64748B",
            DrawerBackground = "#FFFFFF",
            LinesDefault = "#E5E7EB",
            Divider = "#E5E7EB",
            Error = "#DC2626",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
        }
    };

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void Logout() => Auth.Clear();

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}

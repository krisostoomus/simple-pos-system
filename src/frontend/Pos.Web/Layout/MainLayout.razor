@inherits LayoutComponentBase
@using Pos.Web.Components
@using Pos.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiStrings> L

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary" Class="pos-appbar">
        <a href="/" class="pos-brand" aria-label="@L["AppTitle"]">
            <span class="pos-brand-mark">✻</span>
            <span class="pos-brand-text">@L["AppTitle"]</span>
        </a>
        <MudSpacer />
        <LanguageSwitcher />
        <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Inventory">@L["Admin"]</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#18794E",        // the one accent — green
            Secondary = "#115C3A",      // green, pressed
            Tertiary = "#5E6864",       // muted slate
            AppbarBackground = "#FFFFFF",
            Background = "#EDF0EF",      // cool light-gray canvas
            Surface = "#FFFFFF",
            TextPrimary = "#161A18",    // near-black slate
            TextSecondary = "#5E6864",
            ActionDefault = "#5E6864",
            DrawerBackground = "#FFFFFF",
            LinesDefault = "#E1E6E3",
            Divider = "#E1E6E3",
            Error = "#C0493B",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
        }
    };
}

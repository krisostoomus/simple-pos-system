@inherits LayoutComponentBase
@implements IDisposable
@using Pos.Web.Components
@using Pos.Web.Resources
@using Pos.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiStrings> L
@inject AuthState Auth

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="pos-appbar">
        <a href="/" class="pos-brand" aria-label="@L["AppTitle"]">
            <span class="pos-brand-text">@L["AppTitle"]</span>
        </a>

        <nav class="pos-nav">
            <NavLink class="pos-nav-link" href="/" Match="NavLinkMatch.All">@L["Sale"]</NavLink>
            <NavLink class="pos-nav-link" href="/admin" Match="NavLinkMatch.Prefix">@L["Admin"]</NavLink>
        </nav>

        <MudSpacer />
        <div class="pos-header-actions">
            <LanguageSwitcher />
            @if (Auth.IsStaff)
            {
                <MudButton OnClick="Logout" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Logout">@L["Logout"]</MudButton>
            }
        </div>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#059669",        // the one accent — Mint Emerald
            Secondary = "#047857",      // darker emerald, pressed
            Tertiary = "#64748B",       // muted slate
            AppbarBackground = "#F9FAFB", // crisp off-white (never pure white)
            Background = "#F9FAFB",      // crisp off-white canvas
            Surface = "#F9FAFB",         // cards & dialogs — off-white
            TextPrimary = "#1E293B",    // deep slate
            TextSecondary = "#64748B",
            ActionDefault = "#64748B",
            DrawerBackground = "#F9FAFB",
            LinesDefault = "#E5E7EB",   // cool-gray structure
            Divider = "#E5E7EB",
            Error = "#FF4D4F",          // semantic alert tokens
            Warning = "#F59E0B",
            Success = "#059669",       // = accent green (one unified green)
            Info = "#3B82F6",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "16px", // rounded-2xl
        }
    };

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void Logout() => Auth.Clear();

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}

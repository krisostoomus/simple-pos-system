{
  "version": "0.2.0",
  "configurations": [
    {
      // Backend: breakpoints + Hot Reload on save. Waits for DB + build first.
      "name": "API (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prep-api",
      "program": "${workspaceFolder}/src/backend/Pos.Api/bin/Debug/net10.0/Pos.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/Pos.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5261"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      // Frontend: launches the Blazor WASM dev server + browser, attaches the
      // WASM debugger. Supports breakpoints in .razor/.cs and Hot Reload.
      "name": "Web (Blazor WASM)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/frontend/Pos.Web",
      "url": "http://localhost:5189"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API (debug)", "Web (Blazor WASM)"],
      "stopAll": true,
      "presentation": { "group": "1_full", "order": 1 }
    }
  ]
}
